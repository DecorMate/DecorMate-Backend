@{
    ViewData["Title"] = "Password updated";
}
<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card card-brand p-4 text-center">
            <div class="card-body">
                <h4>Password updated</h4>
                <p class="text-muted">Your password has been changed. You can now sign in with the new password.</p>
                <a class="btn brand-btn" href="@Url.Action("Login","Auth")">Go to login</a>
            </div>
        </div>
    </div>
</div>
