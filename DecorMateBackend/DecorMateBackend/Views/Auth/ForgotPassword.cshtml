@model DecorMate_Backend_Web_app.Models.DTOs.ForgotPasswordDto
@{
    ViewData["Title"] = "DecorMate - Forgot Password";
    Layout = null;
}
<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#60a972",
                        "background-light": "#f6f7f7",
                        "background-dark": "#161c17",
                    },
                    fontFamily: {
                        "display": ["Plus Jakarta Sans", "Poppins", "sans-serif"],
                        "poppins": ["Poppins", "sans-serif"]
                    },
                    borderRadius: {
                        "DEFAULT": "0.5rem",
                        "lg": "1rem",
                        "xl": "1.5rem",
                        "full": "9999px"
                    },
                },
            },
        }
    </script>
</head>
<body class="bg-[#EDEDED] font-display">
    <div class="relative flex min-h-screen w-full flex-col items-center overflow-x-hidden">
        <!-- Header -->
        <header class="flex h-40 w-full items-center justify-center bg-gradient-to-r from-[#61AA73] to-[#7BC28D]">
            <h1 class="font-poppins text-3xl font-bold text-white">Forgot Password</h1>
        </header>

        <!-- Main Content -->
        <main class="w-full max-w-5xl px-4 pb-16 md:px-8 -mt-16">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                <!-- Reset Password Card -->
                <div class="lg:col-span-2">
                    <div class="flex flex-col gap-6 rounded-2xl bg-white p-6 sm:p-8 shadow-md">
                        <div class="flex flex-col gap-2">
                            <h2 class="font-poppins text-xl font-bold text-[#212121]">Reset Your Password</h2>
                            <p class="font-poppins text-sm text-[#6D6D6D]">Enter your email address to receive a password reset code.</p>
                        </div>

                        <!-- Validation Summary -->
                        <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm"></div>

                        <form asp-action="ForgotPasswordPost" asp-controller="Auth" method="post" class="flex flex-col gap-6">
                            @Html.AntiForgeryToken()

                            <div class="flex w-full flex-col">
                                <label class="font-poppins text-base font-medium text-[#212121] pb-2" for="Email">Email Address</label>
                                <input asp-for="Email" 
                                       class="form-input flex w-full flex-1 resize-none rounded-lg border border-[#D1D1D1] bg-white h-12 placeholder:text-[#A9A9A9] p-3 text-base font-normal leading-normal text-[#212121] focus:border-[#61AA73] focus:ring-2 focus:ring-[#61AA73]/30 focus:outline-none" 
                                       id="Email" 
                                       name="Email" 
                                       placeholder="Enter your email" 
                                       type="email" 
                                       value="" />
                                <span asp-validation-for="Email" class="text-red-600 text-xs mt-1"></span>
                            </div>

                            <button type="submit" class="flex w-full cursor-pointer items-center justify-center rounded-full h-12 px-5 bg-[#61AA73] text-white text-base font-bold leading-normal tracking-[0.015em] hover:bg-[#529362] transition-colors">
                                <span class="truncate">Get Code</span>
                            </button>
                            
                            <div class="text-center">
                                <a class="font-poppins text-sm text-[#61AA73] hover:underline" href="@Url.Action("Login", "Auth")">Back to login</a>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Sidebar Content -->
                <div class="flex flex-col gap-8">
                    <!-- Help Section -->
                    <div class="flex flex-col gap-4">
                        <div class="flex items-center gap-4 rounded-lg border border-[#9EA484] bg-white p-4">
                            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-[#61AA73]/20 text-[#61AA73]">
                                <span class="material-symbols-outlined">headset_mic</span>
                            </div>
                            <div class="flex-1">
                                <h3 class="font-poppins text-sm font-semibold text-[#212121]">Contact Support</h3>
                                <p class="font-poppins text-xs text-[#6D6D6D]">Get direct help from our team.</p>
                            </div>
                        </div>

                        <div class="flex items-center gap-4 rounded-lg border border-[#9EA484] bg-white p-4">
                            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-[#61AA73]/20 text-[#61AA73]">
                                <span class="material-symbols-outlined">help_outline</span>
                            </div>
                            <div class="flex-1">
                                <h3 class="font-poppins text-sm font-semibold text-[#212121]">Help Center</h3>
                                <p class="font-poppins text-xs text-[#6D6D6D]">Find answers in FAQs &amp; articles.</p>
                            </div>
                        </div>
                    </div>

                    <!-- Security Tips Card -->
                    <div class="flex flex-col gap-4 rounded-xl bg-white p-6">
                        <h3 class="font-poppins text-sm font-semibold text-[#212121]">Security Tips</h3>
                        <ul class="flex flex-col gap-3">
                            <li class="flex items-start gap-3">
                                <span class="material-symbols-outlined text-base text-[#61AA73] mt-0.5">check_circle</span>
                                <p class="font-poppins text-xs text-[#6D6D6D]">Use a strong, unique password with a mix of letters, numbers, and symbols.</p>
                            </li>
                            <li class="flex items-start gap-3">
                                <span class="material-symbols-outlined text-base text-[#61AA73] mt-0.5">check_circle</span>
                                <p class="font-poppins text-xs text-[#6D6D6D]">Never share your password with anyone, including our support staff.</p>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- jQuery + Unobtrusive validation (CDN) -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-..." crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.12/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
