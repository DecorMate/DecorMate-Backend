@{
    ViewData["Title"] = "Registration Confirm";
}
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card card-brand p-4 text-center">
            <div class="card-body">
                <h3>Registration received</h3>
                <p class="lead">Check your email for the OTP code to confirm your account. The code is valid for 10 minutes.</p>
                <p>If you didn't receive the email, please contact support.</p>
                <a class="btn btn-outline-dark" href="@Url.Action("Index","Home")">Back to Home</a>
            </div>
        </div>
    </div>
</div>
