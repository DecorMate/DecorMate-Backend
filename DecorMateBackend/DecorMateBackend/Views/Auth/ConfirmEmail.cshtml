@{
    ViewData["Title"] = "DecorMate - Email Confirmed";
    Layout = null;
}
<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Agbalumo&family=Inika&family=Poppins:wght@400;600&family=Plus+Jakarta+Sans:wght@400;500;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
        .font-agbalumo { font-family: 'Agbalumo', cursive; }
        .font-inika { font-family: 'Inika', serif; }
        .font-poppins { font-family: 'Poppins', sans-serif; }
    </style>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#60a972",
                        "background-light": "#f6f7f7",
                        "background-dark": "#161c17",
                    },
                    fontFamily: {
                        "display": ["Plus Jakarta Sans"]
                    },
                    borderRadius: {"DEFAULT": "0.5rem", "lg": "1rem", "xl": "1.5rem", "full": "9999px"},
                },
            },
        }
    </script>
</head>
<body class="bg-[#EDEDED]">
    <div class="relative flex h-auto min-h-screen w-full flex-col items-center justify-center bg-[#EDEDED] p-4 group/design-root overflow-hidden" style='font-family: "Poppins", "Noto Sans", sans-serif;'>
        <!-- Decorative Elements -->
        <div class="absolute -top-24 -left-24 w-72 h-72 bg-primary/20 rounded-full opacity-50" data-alt="Abstract green circle shape for decoration"></div>
        <div class="absolute -bottom-20 -right-20 w-80 h-80 bg-primary/20 rounded-full opacity-40" data-alt="Abstract green circle shape for decoration"></div>
        
        <div class="relative z-10 w-full max-w-md bg-white/50 backdrop-blur-sm p-8 md:p-10 rounded-xl shadow-lg border border-white/30">
                    <div class="flex flex-col items-center text-center">
                        <!-- Success Icon -->
                        <div class="flex items-center justify-center size-20 bg-[#61AA73]/20 rounded-full mb-6">
                            <span class="material-symbols-outlined text-5xl text-[#61AA73]">check_circle</span>
                        </div>
                        
                        <h3 class="text-[#675D50] text-2xl font-agbalumo tracking-wide mb-2">DecorMate</h3>
                        <h1 class="text-[#000000] text-[22px] font-agbalumo mb-4">Email Confirmed!</h1>
                        
                        <p class="text-gray-600 text-base font-poppins mb-8 max-w-sm">
                            Your email has been successfully confirmed. Your account is now active and you can sign in to continue.
                        </p>
                        
                        <a href="@Url.Action("Login", "Auth")" class="w-full h-12 flex items-center justify-center rounded-xl bg-[#61AA73] text-white font-poppins text-[15px] font-semibold tracking-wide shadow-md hover:bg-[#529362] transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#61AA73]">
                            Sign In
                        </a>
                        
                        <p class="text-center text-sm text-gray-600 mt-6">
                            Need help? 
                            <a class="font-semibold text-[#61AA73] hover:underline" href="@Url.Action("ForgotPassword", "Auth")">Contact Support</a>
                        </p>
                    </div>
        </div>
    </div>
</body>
</html>
