@model DecorMate_Backend_Web_app.Models.DTOs.LoginDto
@{
    ViewData["Title"] = "DecorMate - Sign In";
    Layout = null;
}
<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Agbalumo&family=Inika&family=Poppins:wght@400;600&family=Plus+Jakarta+Sans:wght@400;500;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
        .font-agbalumo { font-family: 'Agbalumo', cursive; }
        .font-inika { font-family: 'Inika', serif; }
        .font-poppins { font-family: 'Poppins', sans-serif; }
    </style>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#60a972",
                        "background-light": "#f6f7f7",
                        "background-dark": "#161c17",
                    },
                    fontFamily: {
                        "display": ["Plus Jakarta Sans"]
                    },
                    borderRadius: {"DEFAULT": "0.5rem", "lg": "1rem", "xl": "1.5rem", "full": "9999px"},
                },
            },
        }
    </script>
</head>
<body class="bg-[#EDEDED]">
    <div class="relative flex h-auto min-h-screen w-full flex-col bg-[#EDEDED] group/design-root" style='font-family: "Poppins", "Noto Sans", sans-serif;'>
        <div class="flex h-full min-h-screen w-full flex-1">
            <div class="flex flex-col md:flex-row flex-1">
                <!-- Left Pane: Image -->
                <div class="hidden md:flex flex-1 relative">
                    <img class="absolute inset-0 h-full w-full object-cover" data-alt="A beautifully decorated modern living room with a couch, chairs, and plants." src="https://lh3.googleusercontent.com/aida-public/AB6AXuDMoXfCDXxt8IM8w4UOoYSBTDRSl8KQ-Q94UWQhEnXGwWwxPiMag6ClsoNMChnz5xUJ-2-3zCv-GDMstrzs0HeUuPJPsjc037uBxlOChDOeu1HoJ3bnCij1LzOby2wwRaumi5ZKMOacj5sENA_nLFEO5JsthMuJP32lcd_Ty9hNcEF0r-wv3-_W98XCCuTOHnfHuTvWXf7hdltIS3dgxcbP_kc3fgKE69AvrFvJU82pT8W5VNJyasoDLif2KIqZegVLkUxD2woCTQk" />
                </div>
                <!-- Right Pane: Form -->
                <div class="flex flex-1 items-center justify-center p-6 sm:p-12 lg:p-16">
                    <div class="w-full max-w-md space-y-8">
                        <div class="text-center">
                            <h1 class="font-agbalumo text-4xl font-normal text-[#675D50]">DecorMate</h1>
                        </div>
                        <div class="text-center">
                            <h2 class="font-agbalumo text-3xl font-normal text-[#121713]">Welcome Back</h2>
                            <p class="font-inika text-lg text-[#6D6D6D] mt-2">Sign in to continue decorating</p>
                        </div>

                        <!-- Validation Summary -->
                        <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm mb-4"></div>

                        <form asp-action="LoginPost" asp-controller="Auth" method="post" class="space-y-6">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                            <div class="flex flex-col">
                                <label class="sr-only" for="email">Email</label>
                                <input asp-for="Email" 
                                       autocomplete="email" 
                                       class="font-poppins form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-xl text-[#121713] focus:outline-0 focus:ring-2 focus:ring-[#61AA73] focus:ring-opacity-50 border border-[#9EA484] bg-white h-12 placeholder:text-[#A3A0A0] p-[15px] text-sm font-normal leading-normal" 
                                       id="email" 
                                       name="Email" 
                                       placeholder="Email" 
                                       required="" 
                                       type="email" />
                                <span asp-validation-for="Email" class="text-red-600 text-xs mt-1"></span>
                            </div>

                            <div class="flex flex-col">
                                <label class="sr-only" for="password">Password</label>
                                <div class="relative flex w-full flex-1 items-center rounded-xl border border-[#9EA484] bg-white focus-within:ring-2 focus-within:ring-[#61AA73] focus-within:ring-opacity-50">
                                    <input asp-for="Password" 
                                           autocomplete="current-password" 
                                           class="font-poppins form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-l-xl text-[#121713] focus:outline-0 focus:ring-0 border-0 bg-transparent h-12 placeholder:text-[#A3A0A0] p-[15px] pr-10 text-sm font-normal leading-normal" 
                                           id="password" 
                                           name="Password" 
                                           placeholder="Password" 
                                           required="" 
                                           type="password" />
                                    <button type="button" 
                                            class="absolute inset-y-0 right-0 flex items-center pr-3 text-[#6D6D6D] hover:text-[#121713] focus:outline-none" 
                                            onclick="togglePasswordVisibility()">
                                        <span class="material-symbols-outlined" id="passwordToggleIcon" data-icon="Eye" data-size="24px" data-weight="regular">visibility</span>
                                    </button>
                                </div>
                                <span asp-validation-for="Password" class="text-red-600 text-xs mt-1"></span>
                            </div>

                            <div class="flex items-center justify-between">
                                <div class="flex items-center">
                                    <input asp-for="RememberMe" 
                                           class="h-4 w-4 text-[#61AA73] focus:ring-[#61AA73] border-[#9EA484] rounded" 
                                           id="rememberMe" 
                                           name="RememberMe" 
                                           type="checkbox" />
                                    <label class="ml-2 text-sm text-[#6D6D6D] font-poppins" for="rememberMe">Remember me</label>
                                </div>
                                <a href="@Url.Action("ForgotPassword", "Auth")" class="text-sm text-[#61AA73] hover:underline font-poppins">Forgot password?</a>
                            </div>

                            <div>
                                <button type="submit" class="font-poppins flex w-full cursor-pointer items-center justify-center overflow-hidden rounded-xl h-12 px-5 bg-[#61AA73] text-white text-base font-semibold leading-normal tracking-[0.015em] shadow-md hover:shadow-lg transition-shadow duration-300">
                                    <span class="truncate">Sign In</span>
                                </button>
                            </div>
                        </form>

                        <div class="flex items-center">
                            <div class="flex-grow border-t border-[#D9D9D9]"></div>
                            <span class="mx-4 flex-shrink text-sm text-[#6D6D6D]">Or continue with</span>
                            <div class="flex-grow border-t border-[#D9D9D9]"></div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <form asp-action="ExternalLogin" asp-controller="Auth" method="post" class="inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="provider" value="Google" />
                                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                                <button type="submit" class="flex items-center justify-center gap-2.5 rounded-xl border-2 border-[#E5D5C8] bg-white px-4 py-2.5 text-sm font-medium text-[#121713] hover:bg-gray-50 transition-colors w-full">
                                    <img alt="Google logo" class="h-5 w-5" src="https://lh3.googleusercontent.com/aida-public/AB6AXuB9kEweuShRvg_SVvyQHjjzaYcp29f9t7BUihXJ6D0AFwGDBDfXvexeUhQFW1ObJP91_fg9Ko0LjyO6F6uZGKVM3_rXonjn6aPW8b1gazM3G3NCtwe8i6dh_tuRFE2tOSPzT87GZ7v3-fzeByUmyFiLdxH0ZH1q0MbMlLcghpzQ78arkO6ARgxxb8krMerGj8WAeAU2fcHhunid6M1m8_r08icT4mYcEPSakYtJv6gYEhoWws4tblSeGubZZ9x9T7mjkkPSoghanQI" />
                                    Google
                                </button>
                            </form>
                            <form asp-action="ExternalLogin" asp-controller="Auth" method="post" class="inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="provider" value="Facebook" />
                                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                                <button type="submit" class="flex items-center justify-center gap-2.5 rounded-xl border-2 border-[#E5D5C8] bg-white px-4 py-2.5 text-sm font-medium text-[#121713] hover:bg-gray-50 transition-colors w-full">
                                    <img alt="Facebook logo" class="h-5 w-5" src="https://lh3.googleusercontent.com/aida-public/AB6AXuA8Jdz8sxKuPhbJebUn0CkSa1tAPvAkPhtq3J-2j-o_lKXvPeJSpD-Mg_my7bQ80W6kG0mvIfsNIvyqzbmJ0VRywqsK8305VHI6BEXeRTjlA-FVu3h-UnOuLmSpGhfD0vS4qY7hoy0lDDfQy4EGgl_btDN_DHMK_xmDIS0Lm81RQ_EXRGcDRYO35cQbymVtVarLk8U340qww2fSvCoosgd9D5gkOGGEkHpd4L_CCg6EPeT7BzTAoQErnuK1H8W5iHpYRAqSHQjGSW4" />
                                    Facebook
                                </button>
                            </form>
                        </div>

                        <div class="text-center">
                            <p class="text-sm text-[#6D6D6D]">
                                Don't have an account? <a class="font-semibold text-[#61AA73] hover:underline" href="@Url.Action("Register", "Auth")">Sign up</a>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        function togglePasswordVisibility() {
            const passwordInput = document.getElementById('password');
            const toggleIcon = document.getElementById('passwordToggleIcon');
            
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                toggleIcon.textContent = 'visibility_off';
            } else {
                passwordInput.type = 'password';
                toggleIcon.textContent = 'visibility';
            }
        }
    </script>

    <!-- jQuery + Unobtrusive validation (CDN) -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-..." crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.12/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
