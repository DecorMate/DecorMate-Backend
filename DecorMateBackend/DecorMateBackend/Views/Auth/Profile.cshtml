@using DecorMateBackend.Models.Enums
@using Microsoft.AspNetCore.Identity
@inject UserManager<DecorMate_Backend_Web_app.Models.ApplicationUser> UserManager
@model DecorMateBackend.Models.DTOs.MvcProfileUpdateViewModel

@{
    ViewData["Title"] = "DecorMate - User Profile";
    Layout = null;
    var currentPic = ViewData["ProfilePictureUrl"] as string ?? ViewBag.ProfilePictureUrl as string;
    var user = await UserManager.GetUserAsync(User);
    var userEmail = user?.Email ?? User?.Identity?.Name ?? "";
    var fullName = $"{Model.FirstName ?? ""} {Model.LastName ?? ""}".Trim();
    if (string.IsNullOrEmpty(fullName))
    {
        fullName = userEmail;
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;700;800&family=Poppins:wght@400;500;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
    <style>
        .gradient-header {
            background: linear-gradient(to right, #f2eee8, #e9f1e8);
        }
    </style>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#60a972",
                        "background-light": "#f6f7f7",
                        "background-dark": "#161c17",
                    },
                    fontFamily: {
                        "display": ["Poppins", "Plus Jakarta Sans", "sans-serif"]
                    },
                    borderRadius: {"DEFAULT": "0.5rem", "lg": "1rem", "xl": "1.5rem", "full": "9999px"},
                },
            },
        }
    </script>
</head>
<body class="font-display">
    <div class="relative flex min-h-screen w-full flex-col bg-[#EDEDED] group/design-root overflow-x-hidden">
        <div class="layout-container flex h-full grow flex-col">
            <header class="flex items-center justify-center whitespace-nowrap px-10 py-3 gradient-header sticky top-0 z-10">
                <div class="flex w-full max-w-[960px] items-center justify-between">
                    <div class="flex items-center gap-4 text-[#5B3308]">
                        <div class="size-6 text-[#61AA73]">
                            <svg fill="none" viewbox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
                                <path d="M24 4C25.7818 14.2173 33.7827 22.2182 44 24C33.7827 25.7818 25.7818 33.7827 24 44C22.2182 33.7827 14.2173 25.7818 4 24C14.2173 22.2182 22.2182 14.2173 24 4Z" fill="currentColor"></path>
                            </svg>
                        </div>
                        <a href="@Url.Action("Index", "Home")" class="text-xl font-bold tracking-[-0.015em]">DecorMate</a>
                    </div>
                    <div class="flex flex-1 justify-end gap-8">
                        <div class="hidden md:flex items-center gap-9">
                            <a class="text-[#5B3308] text-sm font-medium leading-normal" href="@Url.Action("Index", "Home")">Home</a>
                            <a class="text-[#5B3308] text-sm font-medium leading-normal" href="#">Projects</a>
                            <a class="text-[#5B3308] text-sm font-medium leading-normal" href="#">Inspirations</a>
                        </div>
                        <div class="flex gap-2">
                            <button class="flex max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-full h-10 bg-black/5 text-[#5B3308] gap-2 text-sm font-bold leading-normal tracking-[0.015em] min-w-0 px-2.5">
                                <span class="material-symbols-outlined text-xl">notifications</span>
                            </button>
                            <button class="flex max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-full h-10 bg-black/5 text-[#5B3308] gap-2 text-sm font-bold leading-normal tracking-[0.015em] min-w-0 px-2.5">
                                <span class="material-symbols-outlined text-xl">chat_bubble</span>
                            </button>
                        </div>
                        <div class="bg-center bg-no-repeat aspect-square bg-cover rounded-full size-10" data-alt="User avatar image" style='background-image: url("@(string.IsNullOrEmpty(currentPic) ? "https://lh3.googleusercontent.com/aida-public/AB6AXuCnyHpCFxFkLLo0g2NyFWaBBhEQ9fono6NNEPiFXDgzp6qdMCWsc2MNdS_sTDUqF190FQplPTqrhaYDuFApxSkjKi1B0154jv0t8o7_Z8uzwLueZvTSWRpaIqj20RwGbgVOPe6bVK2WY9vWVkHR9EacXDfyY1yvS0Bbnt-gpY76zf8VRNP-jy2DI22JopD-f2BAgPT7cHdF_OQPJJbYMLnkN5KoM4Y-LDvYiNEISDixzf_u3AEbhbVCmdpEuEaqlQRqsw1_efqt4OQ" : currentPic)");'></div>
                    </div>
                </div>
            </header>

            <main class="flex flex-1 justify-center py-10 px-5">
                <div class="flex w-full max-w-[720px] flex-col gap-8">
                    <!-- Profile Header -->
                    <div class="flex p-4">
                        <div class="flex w-full flex-col gap-4 items-center">
                            <div class="relative">
                                <div class="bg-center bg-no-repeat aspect-square bg-cover rounded-xl size-[66px]" data-alt="User profile picture" style='background-image: url("@(string.IsNullOrEmpty(currentPic) ? "https://lh3.googleusercontent.com/aida-public/AB6AXuDpWyNF2Ztwo6d7pV3YS4WgjOnc0Xc7ulkW6QzXXELbJD4TCmCKviroCrb9K2U7SOevPELOsp7-T4gn9qhpHeTi_jFHXJsgEihCdyRvYh4q_DqdMfU_Mc-8UhftqQMRw75YafXR8BzYQYlGaHNMamsPnI6BGpKWQesl4gBUJ8elN-3B0dAT-OLv8ZOqcrQzPFK4Lc5kXHQlUObLYj8KgiHmhKDmKPqPUdgNQLUId5FFit46NhQimjsQ7djXZKE-n3eNzNY-UZbe1RQ" : currentPic)");' id="profilePicturePreview"></div>
                                <label for="ProfileImage" class="absolute bottom-0 right-0 flex items-center justify-center size-6 bg-[#61AA73] rounded-full border-2 border-white cursor-pointer hover:bg-[#559865] transition-colors">
                                    <span class="material-symbols-outlined text-sm text-white">photo_camera</span>
                                </label>
                                <input type="file" id="ProfileImage" name="ProfileImage" accept="image/jpeg,image/png,image/webp" style="display:none;" />
                            </div>
                            <div class="flex flex-col justify-center text-center">
                                <p class="text-[#5B3308] text-2xl font-bold leading-tight tracking-[-0.015em]">@fullName</p>
                                <p class="text-gray-500 text-base font-normal leading-normal">@userEmail</p>
                            </div>
                        </div>
                    </div>

                    <!-- Personal Information Card -->
                    <form asp-action="ProfilePost" asp-controller="Auth" method="post" enctype="multipart/form-data" class="flex flex-col rounded-2xl border border-[#9EA484] bg-white p-6 shadow-[0_4px_12px_rgba(0,0,0,0.05)]">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="RemovePicture" name="RemovePicture" value="false" />
                        
                        <h3 class="text-[#5B3308] text-lg font-bold leading-tight tracking-[-0.015em] pb-6">Personal Information</h3>
                        
                        <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm mb-4"></div>
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-4">
                            <label class="flex flex-col">
                                <p class="text-[#5B3308] text-sm font-medium pb-2">First Name</p>
                                <input asp-for="FirstName" class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-lg text-[#5B3308] focus:outline-0 focus:ring-2 focus:ring-[#61AA73]/50 border border-[#9EA484] bg-white h-12 placeholder:text-gray-400 px-3 text-base font-normal" />
                                <span asp-validation-for="FirstName" class="text-red-600 text-xs mt-1"></span>
                            </label>

                            <label class="flex flex-col">
                                <p class="text-[#5B3308] text-sm font-medium pb-2">Last Name</p>
                                <input asp-for="LastName" class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-lg text-[#5B3308] focus:outline-0 focus:ring-2 focus:ring-[#61AA73]/50 border border-[#9EA484] bg-white h-12 placeholder:text-gray-400 px-3 text-base font-normal" />
                                <span asp-validation-for="LastName" class="text-red-600 text-xs mt-1"></span>
                            </label>

                            <label class="flex flex-col">
                                <p class="text-[#5B3308] text-sm font-medium pb-2">Email</p>
                                <input type="email" value="@userEmail" class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-lg text-[#5B3308] focus:outline-0 focus:ring-2 focus:ring-[#61AA73]/50 border border-[#9EA484] bg-gray-100 h-12 placeholder:text-gray-400 px-3 text-base font-normal" disabled />
                                <small class="text-gray-500 text-xs mt-1">Email cannot be changed</small>
                            </label>

                            <label class="flex flex-col">
                                <p class="text-[#5B3308] text-sm font-medium pb-2">Phone Number</p>
                                <input asp-for="PhoneNumber" class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-lg text-[#5B3308] focus:outline-0 focus:ring-2 focus:ring-[#61AA73]/50 border border-[#9EA484] bg-white h-12 placeholder:text-gray-400 px-3 text-base font-normal" />
                                <span asp-validation-for="PhoneNumber" class="text-red-600 text-xs mt-1"></span>
                            </label>
                        </div>

                        <button type="submit" class="flex items-center justify-center rounded-xl h-12 px-6 bg-[#61AA73] text-white text-base font-bold mt-6 ml-auto hover:bg-[#559865] transition-colors">Save Changes</button>
                    </form>

                    <!-- Account Actions Card -->
                    <div class="flex flex-col rounded-2xl border border-[#9EA484] bg-white p-6 shadow-[0_4px_12px_rgba(0,0,0,0.05)]">
                        <h3 class="text-[#5B3308] text-lg font-bold leading-tight tracking-[-0.015em] pb-4">Account Actions</h3>
                        <div class="flex flex-col gap-2">
                            <button class="flex w-full items-center justify-between rounded-lg p-3 text-left text-[#5B3308] hover:bg-gray-100 transition-colors">
                                <span class="font-medium">Change account</span>
                                <span class="material-symbols-outlined text-xl text-gray-500">arrow_forward_ios</span>
                            </button>
                            <a href="@Url.Action("ForgotPassword", "Auth")" class="flex w-full items-center justify-between rounded-lg p-3 text-left text-[#5B3308] hover:bg-gray-100 transition-colors">
                                <span class="font-medium">Change password</span>
                                <span class="material-symbols-outlined text-xl text-gray-500">arrow_forward_ios</span>
                            </a>
                            <button class="flex w-full items-center justify-between rounded-lg p-3 text-left text-red-600 hover:bg-red-50 transition-colors">
                                <span class="font-medium">Delete Account</span>
                                <span class="material-symbols-outlined text-xl">arrow_forward_ios</span>
                            </button>
                        </div>
                    </div>

                    <!-- Support & Help Card -->
                    <div class="flex flex-col rounded-2xl border border-[#9EA484] bg-white p-6 shadow-[0_4px_12px_rgba(0,0,0,0.05)]">
                        <h3 class="text-[#5B3308] text-lg font-bold leading-tight tracking-[-0.015em] pb-4">Support &amp; Help</h3>
                        <div class="flex flex-col divide-y divide-gray-200">
                            <a class="flex w-full items-center gap-4 py-4 text-left text-[#5B3308] hover:bg-gray-100 transition-colors rounded-t-lg px-2" href="#">
                                <span class="material-symbols-outlined text-2xl text-[#61AA73]">help_center</span>
                                <span class="font-medium flex-1">Help Center</span>
                                <span class="material-symbols-outlined text-xl text-gray-500">arrow_forward_ios</span>
                            </a>
                            <a class="flex w-full items-center gap-4 py-4 text-left text-[#5B3308] hover:bg-gray-100 transition-colors px-2" href="#">
                                <span class="material-symbols-outlined text-2xl text-[#61AA73]">support_agent</span>
                                <span class="font-medium flex-1">Contact Support</span>
                                <span class="material-symbols-outlined text-xl text-gray-500">arrow_forward_ios</span>
                            </a>
                            <a class="flex w-full items-center gap-4 py-4 text-left text-[#5B3308] hover:bg-gray-100 transition-colors px-2" href="#">
                                <span class="material-symbols-outlined text-2xl text-[#61AA73]">star</span>
                                <span class="font-medium flex-1">Rate App</span>
                                <span class="material-symbols-outlined text-xl text-gray-500">arrow_forward_ios</span>
                            </a>
                            <a class="flex w-full items-center gap-4 py-4 text-left text-[#5B3308] hover:bg-gray-100 transition-colors rounded-b-lg px-2" href="#">
                                <span class="material-symbols-outlined text-2xl text-[#61AA73]">gavel</span>
                                <span class="font-medium flex-1">Terms &amp; Privacy</span>
                                <span class="material-symbols-outlined text-xl text-gray-500">arrow_forward_ios</span>
                            </a>
                        </div>
                    </div>

                    <!-- Sign Out Button -->
                    <div class="pt-4">
                        <form method="post" action="@Url.Action("Logout", "Auth")" class="inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="flex w-full max-w-[480px] mx-auto cursor-pointer items-center justify-center overflow-hidden rounded-xl h-14 bg-[#61AA73] text-white gap-3 text-lg font-extrabold tracking-[0.015em] hover:bg-[#559865] transition-colors">
                                <span class="material-symbols-outlined">logout</span>
                                Sign Out
                            </button>
                        </form>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <script>
        (function () {
            const fileInput = document.getElementById('ProfileImage');
            const preview = document.getElementById('profilePicturePreview');
            const removeHidden = document.getElementById('RemovePicture');

            fileInput?.addEventListener('change', function (e) {
                const f = this.files && this.files[0];
                if (!f) return;

                if (f.size > 5 * 1024 * 1024) {
                    alert('File too large. Max 5MB.');
                    this.value = '';
                    return;
                }

                const allowed = ['image/jpeg', 'image/png', 'image/webp'];
                if (!allowed.includes(f.type)) {
                    alert('Unsupported file type. Allowed: jpeg, png, webp.');
                    this.value = '';
                    return;
                }

                const reader = new FileReader();
                reader.onload = function (ev) {
                    if (preview) {
                        preview.style.backgroundImage = 'url(' + ev.target.result + ')';
                    }
                    if (removeHidden) {
                        removeHidden.value = "false";
                    }
                };
                reader.readAsDataURL(f);
            });
        })();
    </script>

    <!-- jQuery + Unobtrusive validation (CDN) -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-..." crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.12/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
