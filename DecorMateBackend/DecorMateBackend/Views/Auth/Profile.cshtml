@using DecorMateBackend.Models.Enums
@model DecorMateBackend.Models.DTOs.MvcProfileUpdateViewModel

@{
    ViewData["Title"] = "Profile";
    var currentPic = ViewData["ProfilePictureUrl"] as string ?? ViewBag.ProfilePictureUrl as string;
    // helper to render enum names nicely
    Func<ProfessionalCategory, string> enumLabel = e => e.ToString();
}

<h2 class="mb-3">My Profile</h2>

<div class="row">
    <div class="col-md-4">
        <div class="card mb-4">
            <div class="card-body text-center">
                <div class="mb-3">
                    @if (!string.IsNullOrEmpty(currentPic))
                    {
                        <img id="previewImg" src="@currentPic" alt="Profile" class="img-fluid rounded" style="max-height:220px;object-fit:cover;" />
                    }
                    else
                    {
                        <div id="previewImg" class="bg-light rounded d-flex align-items-center justify-content-center" style="height:220px;">
                            <span class="text-muted">No profile picture</span>
                        </div>
                    }
                </div>

                <small class="text-muted d-block mb-2">Allowed types: .jpg .png .webp — max 5MB</small>

                <div class="d-grid gap-2">
                    <label class="btn btn-outline-secondary">
                        Change picture
                        <input type="file" id="ProfileImage" name="ProfileImage" accept="image/*" style="display:none;" />
                    </label>
                    <button id="removePicBtn" type="button" class="btn btn-outline-danger" @(string.IsNullOrEmpty(currentPic) ? "disabled" : "")>Remove</button>
                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <h6>Account</h6>
                <p class="mb-0"><strong>Email</strong></p>
                <p class="text-muted">@User?.Identity?.Name</p>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <form asp-action="ProfilePost" asp-controller="Auth" method="post" enctype="multipart/form-data" class="card p-3" novalidate>
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="FirstName" class="form-label">First name</label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="LastName" class="form-label">Last name</label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PhoneNumber" class="form-label">Phone number</label>
                <input asp-for="PhoneNumber" class="form-control" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CompanyName" class="form-label">Company / Workshop name</label>
                <input asp-for="CompanyName" class="form-control" />
                <span asp-validation-for="CompanyName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Location" class="form-label">Location (optional)</label>
                <input asp-for="Location" class="form-control" placeholder="City / Neighbourhood" />
                <small class="form-text text-muted">Used to match local vendors to users nearby.</small>
                <span asp-validation-for="Location" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Professional category (optional)</label>
                <select name="ProfessionalCategory" class="form-select">
                    <option value="">-- Select category (optional) --</option>
                    @foreach (ProfessionalCategory val in Enum.GetValues(typeof(ProfessionalCategory)))
                    {
                        var intValue = (int)val;
                        var isSelected = Model.ProfessionalCategory.HasValue && Model.ProfessionalCategory.Value == val;
                        if (isSelected)
                        {
                            <option value="@intValue" selected="selected">@enumLabel(val)</option>
                        }
                        else
                        {
                            <option value="@intValue">@enumLabel(val)</option>
                        }
                    }
                </select>
                <small class="form-text text-muted">Examples: Designer, Carpenter, Factory, Upholsterer, Finisher.</small>
            </div>

            <input type="hidden" id="RemovePicture" name="RemovePicture" value="false" />

            <div class="d-flex justify-content-between mt-4">
                <a class="btn btn-outline-secondary" href="@Url.Action("Index", "Home")">Cancel</a>
                <button type="submit" class="btn" style="background:#FEB47B;color:#111;font-weight:600;">Save profile</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

    <script>
        (function () {
            const fileInput = document.getElementById('ProfileImage');
            const preview = document.getElementById('previewImg');
            const removeBtn = document.getElementById('removePicBtn');
            const removeHidden = document.getElementById('RemovePicture');

            fileInput?.addEventListener('change', function (e) {
                const f = this.files && this.files[0];
                if (!f) return;

                if (f.size > 5 * 1024 * 1024) {
                    alert('File too large. Max 5MB.');
                    this.value = '';
                    return;
                }

                const allowed = ['image/jpeg', 'image/png', 'image/webp'];
                if (!allowed.includes(f.type)) {
                    alert('Unsupported file type. Allowed: jpeg, png, webp.');
                    this.value = '';
                    return;
                }

                const reader = new FileReader();
                reader.onload = function (ev) {
                    const prev = document.getElementById('previewImg');
                    if (prev && prev.tagName === 'IMG') {
                        prev.src = ev.target.result;
                    } else if (prev) {
                        prev.outerHTML = '<img id="previewImg" class="img-fluid rounded" style="max-height:220px;object-fit:cover;" src="' + ev.target.result + '" />';
                    }
                    removeBtn.disabled = false;
                    removeHidden.value = "false";
                };
                reader.readAsDataURL(f);
            });

            removeBtn?.addEventListener('click', function () {
                if (fileInput) fileInput.value = '';
                removeHidden.value = "true";
                const ph = '<div id="previewImg" class="bg-light rounded d-flex align-items-center justify-content-center" style="height:220px;"><span class="text-muted">No profile picture</span></div>';
                const prev = document.getElementById('previewImg');
                if (prev) prev.outerHTML = ph;
                removeBtn.disabled = true;
            });
        })();
    </script>
}
