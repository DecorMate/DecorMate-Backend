@{
    ViewData["Title"] = "Forgot password sent";
}
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card card-brand p-4 text-center">
            <div class="card-body">
                <h4>We sent instructions</h4>
                <p class="text-muted">If that email exists in our system, you'll receive a reset code or link shortly.</p>
                <a class="btn btn-outline-dark" href="@Url.Action("Login","Auth")">Back to login</a>
            </div>
        </div>
    </div>
</div>
