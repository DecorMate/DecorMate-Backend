@using Microsoft.AspNetCore.Identity
@inject SignInManager<DecorMate_Backend_Web_app.Models.ApplicationUser> SignInManager
@inject UserManager<DecorMate_Backend_Web_app.Models.ApplicationUser> UserManager
@{
    ViewData["Title"] = "DecorMate - Inspiration Gallery";
    Layout = null;
    var user = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;
    var profilePic = user?.ProfilePictureUrl;
}
<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#13ec49",
                        "background-light": "#f6f8f6",
                        "background-dark": "#102215",
                        "surface-light": "#ffffff",
                        "surface-dark": "#1a2c1f",
                        "text-light-primary": "#0d1b11",
                        "text-dark-primary": "#e7f3ea",
                        "text-light-secondary": "#4c9a5f",
                        "text-dark-secondary": "#a2d8b0",
                        "border-light": "#e7f3ea",
                        "border-dark": "#364d3d"
                    },
                    fontFamily: {
                        "display": ["Plus Jakarta Sans", "sans-serif"]
                    },
                    borderRadius: {"DEFAULT": "0.75rem", "lg": "1rem", "xl": "1.5rem", "full": "9999px"},
                },
            },
        }
    </script>
</head>
<body class="font-display bg-background-light dark:bg-background-dark">
    <div class="relative flex h-auto min-h-screen w-full flex-col">
        <!-- TopNavBar -->
        <header class="sticky top-0 z-50 flex items-center justify-between whitespace-nowrap border-b border-solid border-border-light dark:border-border-dark bg-background-light/80 dark:bg-background-dark/80 px-6 sm:px-10 lg:px-20 py-3 backdrop-blur-sm">
            <div class="flex items-center gap-4 text-text-light-primary dark:text-text-dark-primary">
                <div class="size-6 text-primary">
                    <svg fill="none" viewbox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
                        <path d="M24 4C25.7818 14.2173 33.7827 22.2182 44 24C33.7827 25.7818 25.7818 33.7827 24 44C22.2182 33.7827 14.2173 25.7818 4 24C14.2173 22.2182 22.2182 14.2173 24 4Z" fill="currentColor"></path>
                    </svg>
                </div>
                <a href="@Url.Action("Index", "Home")" class="text-lg font-bold leading-tight tracking-[-0.015em]">DecorMate</a>
            </div>
            <nav class="hidden md:flex flex-1 justify-center items-center gap-9">
                <a class="text-text-light-primary dark:text-text-dark-primary text-sm font-medium leading-normal hover:text-primary dark:hover:text-primary transition-colors" href="@Url.Action("Index", "Home")">Home</a>
                <a class="text-primary dark:text-primary text-sm font-bold leading-normal" href="@Url.Action("Gallery", "Home")">Inspiration</a>
                <a class="text-text-light-primary dark:text-text-dark-primary text-sm font-medium leading-normal hover:text-primary dark:hover:text-primary transition-colors" href="#">Design Tool</a>
                <a class="text-text-light-primary dark:text-text-dark-primary text-sm font-medium leading-normal hover:text-primary dark:hover:text-primary transition-colors" href="#">Shop</a>
            </nav>
            <div class="flex items-center gap-3">
                @if (SignInManager.IsSignedIn(User))
                {
                    <a href="@Url.Action("Profile", "Auth")" class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-full h-10 px-5 bg-primary text-text-light-primary text-sm font-bold leading-normal tracking-[0.015em] hover:opacity-90 transition-opacity">
                        <span class="truncate">Upload Design</span>
                    </a>
                    <button class="flex max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-full h-10 bg-primary/20 text-text-light-primary dark:text-text-dark-primary dark:bg-primary/20 gap-2 text-sm font-bold leading-normal tracking-[0.015em] min-w-0 px-2.5 hover:bg-primary/30 transition-colors">
                        <span class="material-symbols-outlined text-xl">notifications</span>
                    </button>
                    <a href="@Url.Action("Profile", "Auth")" class="bg-center bg-no-repeat aspect-square bg-cover rounded-full size-10" data-alt="User avatar image" style='background-image: url("@(string.IsNullOrEmpty(profilePic) ? "https://lh3.googleusercontent.com/aida-public/AB6AXuCNGNtVLuC1cgAo4WXWdBV2HKVDgeMWwCW81tRFeTp30zFDXvvSzxPSO3nd0RtS1As8_7n6UqcEghFUcw-_FmbtcmNDn4nxNRukS9iCmkSndYiz04gSTeraRhdCjJOMm4h6dBUnGq_uHqCcOkghdieDle0G2cHp7ZtU7-QSX-uRY8kVfC3dDcF7hL1CNhIkXqtr8uW-91fjz2C651odxrWspB7fQ5Dvey_2QSQ_FXwnbyEO9RHf7zzmT-v1ksW0Eo0y0U-noRTDeyM" : profilePic)");'></a>
                }
                else
                {
                    <a href="@Url.Action("Register", "Auth")" class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-full h-10 px-5 bg-primary text-text-light-primary text-sm font-bold leading-normal tracking-[0.015em] hover:opacity-90 transition-opacity">
                        <span class="truncate">Upload Design</span>
                    </a>
                    <a href="@Url.Action("Login", "Auth")" class="flex max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-full h-10 bg-primary/20 text-text-light-primary dark:text-text-dark-primary dark:bg-primary/20 gap-2 text-sm font-bold leading-normal tracking-[0.015em] min-w-0 px-2.5 hover:bg-primary/30 transition-colors">
                        <span class="material-symbols-outlined text-xl">notifications</span>
                    </a>
                }
            </div>
