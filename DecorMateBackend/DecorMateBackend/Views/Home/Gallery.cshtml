                            </div>
                            <button class="flex h-10 shrink-0 items-center justify-center gap-x-2 rounded-md bg-primary/20 dark:bg-primary/20 pl-4 pr-3 text-text-light-primary dark:text-text-dark-primary hover:bg-primary/30 transition-colors">
                                <p class="text-sm font-medium leading-normal">Most Popular</p>
                                <span class="material-symbols-outlined text-xl">expand_more</span>
                            </button>
                        </div>
                    </div>
