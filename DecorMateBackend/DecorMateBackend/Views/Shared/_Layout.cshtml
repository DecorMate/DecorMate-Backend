@using Microsoft.AspNetCore.Identity
@inject SignInManager<DecorMate_Backend_Web_app.Models.ApplicationUser> SignInManager
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - DecorMate</title>

    <!-- Bootstrap 5 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        :root {
            --brand: #FEB47B; /* brand color used in emails */
            --brand-dark: #e09a63;
        }
        .brand-bg { background: var(--brand); }
        .brand-btn { background: var(--brand); border-color: var(--brand); color: #111; }
        .brand-btn:hover { background: var(--brand-dark); border-color: var(--brand-dark); color: #111; }
        .card-brand { border: none; box-shadow: 0 6px 20px rgba(0,0,0,0.06); }
        a.brand-link { color: #222; font-weight:700; text-decoration:none; }
        footer.site-footer { background:#f8f9fa; padding:18px 0; color:#666; }
    </style>

    @RenderSection("Head", required: false)
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-light brand-bg">
        <div class="container">
            <a class="navbar-brand brand-link" href="@Url.Action("Index", "Home")">DecorMate</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Home")">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Privacy", "Home")">About</a></li>
                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="@Url.Action("Plan","Payments")">Plan</a>
                        </li>
                    }
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Profile", "Auth")">Profile</a></li>
                        <li class="nav-item">
                            <form method="post" action="@Url.Action("Logout", "Auth")" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-dark ms-2">Logout</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Login", "Auth")">Login</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Register", "Auth")">Register</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="py-5">
        <div class="container">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }
            @if (TempData["Warning"] != null)
            {
                <div class="alert alert-warning">@TempData["Warning"]</div>
            }
            @RenderBody()
        </div>
    </main>

    <footer class="site-footer">
        <div class="container text-center">
            <small>© @DateTime.UtcNow.Year DecorMate. All rights reserved.</small>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
