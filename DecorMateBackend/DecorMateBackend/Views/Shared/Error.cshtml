@model DecorMate_Backend_Web_app.Models.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card p-4">
            <div class="card-body text-center">
                <h3>Something went wrong</h3>
                <p>@Model?.Message</p>
                <small>Request id: @Model?.RequestId</small>
                <div class="mt-3">
                    <a class="btn btn-outline-dark" href="@Url.Action("Index","Home")">Back to home</a>
                </div>
            </div>
        </div>
    </div>
</div>
