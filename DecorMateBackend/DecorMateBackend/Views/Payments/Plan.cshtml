@{
    ViewData["Title"] = "Plans";
    Layout = "_Layout";
}
<div class="container py-4">
    <h2 class="mb-3">Choose a plan</h2>
    <p class="text-muted">Upgrade to Premium to get featured listings and higher visibility.</p>

    <div class="row gy-3">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Standard</h5>
                    <p class="card-text">Standard — free listing</p>
                    <p class="h4">0 EGP</p>

                    <form method="post" action="/Payments/Start">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Plan" value="Standard" />
                        <div class="mb-2">
                            <label class="form-label">Phone (Vodafone Cash)</label>
                            <input name="PhoneNumber" class="form-control" placeholder="01xxxxxxxxx" />
                        </div>
                        <button class="btn btn-outline-secondary">Select standard</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Premium</h5>
                    <p class="card-text">Premium — featured/sponsored (monthly)</p>
                    <p class="h4">50 EGP / month</p>

                    <form method="post" action="/Payments/Start">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Plan" value="Premium" />
                        <div class="mb-2">
                            <label class="form-label">Phone (Vodafone Cash)</label>
                            <input name="PhoneNumber" class="form-control" placeholder="01xxxxxxxxx" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Notes (optional)</label>
                            <input name="Notes" class="form-control" />
                        </div>
                        <button class="btn" style="background:#FEB47B;color:#111;border:none;">Pay via Vodafone Cash</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
