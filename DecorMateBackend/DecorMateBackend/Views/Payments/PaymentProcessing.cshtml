@model DecorMate_Backend_Web_app.Models.PaymentRecord
@{
    ViewData["Title"] = "Processing payment";
    Layout = "_Layout";
}
<div class="container py-4">
    <div class="card shadow-sm">
        <div class="card-body text-center">
            <h4 class="mb-3">Processing your payment</h4>
            <p class="text-muted">Follow the instructions on your phone to complete the Vodafone Cash payment.</p>

            <p><strong>Amount:</strong> @Model.Amount.ToString("0.##") EGP</p>
            <p><strong>Phone:</strong> @Model.PhoneNumber</p>

            <p class="mt-3">When you finish the payment, click below to check status.</p>
            <a class="btn" href="@Url.Action("PaymentConfirmation","Payments", new { id = Model.Id })" style="background:#FEB47B;color:#111;border:none;">Check status</a>
        </div>
    </div>
</div>
